# Copy to `.env` (git-ignored) and fill in locally. Never commit real values.
# The Angular app itself reads its config from src/environments/*.ts.

# --- Live / E2E Supabase project (e2e/live-*, scripts/*) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable anon key>

# Test accounts used by the live Playwright suites and scripts/audit-ui.mjs
E2E_ADMIN_EMAIL=admin@turf.local
E2E_COACH_EMAIL=coach@turf.local
E2E_RECEPTIONIST_EMAIL=receptionist@turf.local
E2E_PARENT_EMAIL=parent@turf.local
E2E_PASSWORD=change-me

# Server-side only: create/verify test accounts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# --- Optional tooling ---
# scripts/backup-database.mjs
SUPABASE_CLI_PATH=supabase
BACKUP_TIMEOUT_MS=600000
# scripts/backup-database.mjs / reset tooling: must be set before touching a live project
CONFIRM_TEST_PROJECT=
# scripts/audit-ui.mjs
UI_AUDIT_PHASE=before
UI_AUDIT_QUICK=0
