{
  "name": "turf-academy-ui",
  "version": "0.1.0",
  "description": "Turf Cricket Academy management UI: students, attendance, fees, payments, notifications and reports (Angular + Supabase).",
  "license": "UNLICENSED",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:notifications": "ng test --ts-config=tsconfig.notifications.spec.json --watch=false --include=src/app/features/notifications/*.spec.ts --include=src/app/core/supabase/notification-*.spec.ts --include=src/app/features/settings/academy-settings-page.spec.ts --include=src/app/shared/whatsapp-action/whatsapp-action.spec.ts --include=src/app/shared/notification-section-nav/notification-section-nav.spec.ts",
    "test:notifications:db": "node scripts/test-notification-db.mjs",
    "test:notifications:live": "node scripts/verify-notification-live.mjs",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "test:provision": "node scripts/provision-live-test-accounts.mjs",
    "backup": "node scripts/backup-database.mjs",
    "lint": "ng lint",
    "test:e2e:pwa": "playwright test --config=playwright.pwa.config.ts",
    "test:e2e:recovery": "playwright test --config=playwright.recovery.config.ts",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:e2e:all": "npm run test:e2e && npm run test:e2e:live && npm run test:e2e:pwa",
    "serve:prod": "http-server dist/turf-academy-ui/browser -p 4300 -c-1"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.0",
    "@primeuix/themes": "^3.0.0",
    "@supabase/supabase-js": "^2.115.0",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "primeicons": "^8.0.0",
    "primeng": "^22.0.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "^4.12.1",
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "http-server": "^14.1.1",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.25",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^4.0.8"
  }
}
